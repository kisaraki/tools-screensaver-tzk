#pragma code_page(65001)
#include <windows.h>
#include "resource.h"
#include "version.generated.h"

LANGUAGE LANG_CHINESE, SUBLANG_CHINESE_TRADITIONAL

IDI_APP ICON "../assets/app.ico"
IDR_MANIFEST RT_MANIFEST "app.manifest"

STRINGTABLE
BEGIN
    IDS_APP_NAME "日期時間螢幕保護程式"
END

IDD_CONFIG DIALOGEX 0, 0, 360, 355
STYLE DS_SHELLFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "日期時間螢幕保護程式設定"
FONT 9, "Microsoft JhengHei UI"
BEGIN
    GROUPBOX "顯示模式", -1, 8, 7, 164, 74
    AUTORADIOBUTTON "標準桌曆暨時鐘模式(&T)", IDC_MODE_TIME_DATE, 18, 22, 146, 12, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "離機作業番茄鐘模式(&C)", IDC_MODE_COUNTDOWN, 18, 40, 146, 12
    AUTORADIOBUTTON "日本旅行模式(&J)", IDC_MODE_JAPAN_TRAVEL, 18, 58, 146, 12

    GROUPBOX "主色", -1, 179, 7, 173, 74
    AUTORADIOBUTTON "深紅(&R)", IDC_COLOR_DARK_RED, 189, 22, 68, 12, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "深橘(&O)", IDC_COLOR_DARK_ORANGE, 270, 22, 68, 12
    AUTORADIOBUTTON "亮綠(&G)", IDC_COLOR_BRIGHT_GREEN, 189, 40, 68, 12
    AUTORADIOBUTTON "灰白(&W)", IDC_COLOR_OFF_WHITE, 270, 40, 68, 12

    LTEXT "需要網路；全螢幕時連線至 tw.live 與 YouTube，影片靜音。", -1, 10, 86, 340, 12

    GROUPBOX "日本旅行場景", -1, 8, 104, 344, 42
    AUTORADIOBUTTON "自在飛行(&A)", IDC_TRAVEL_FREE_FLIGHT, 18, 120, 128, 12, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "列車旅行(&N)", IDC_TRAVEL_TRAIN_JOURNEY, 179, 120, 128, 12

    GROUPBOX "字型", -1, 8, 153, 344, 57
    LTEXT "顯示字型(&F)：", -1, 18, 169, 72, 12
    COMBOBOX IDC_FONT_COMBO, 91, 166, 151, 82, CBS_DROPDOWNLIST | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON "選擇系統字型…(&S)", IDC_CHOOSE_FONT, 249, 165, 91, 16
    LTEXT "字型大小會依顯示空間自動縮放。", -1, 18, 189, 250, 12

    GROUPBOX "即時預覽", -1, 8, 216, 344, 99
    CONTROL "", IDC_PREVIEW, "STATIC", SS_OWNERDRAW | WS_BORDER | WS_CHILD | WS_VISIBLE, 16, 229, 328, 78

    ICON IDI_APP, -1, 12, 326, 18, 18
    LTEXT "KOMSMOS TOOLKIT", -1, 36, 327, 102, 9
    LTEXT "探真拓知酷", -1, 36, 336, 78, 9

    DEFPUSHBUTTON "確定", IDOK, 244, 330, 50, 16
    PUSHBUTTON "取消", IDCANCEL, 302, 330, 50, 16
END

IDD_COUNTDOWN_INPUT DIALOGEX 0, 0, 240, 128
STYLE DS_SHELLFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "設定倒數時間"
FONT 9, "Microsoft JhengHei UI"
BEGIN
    LTEXT "請輸入本次倒數時間。", -1, 12, 12, 210, 12
    LTEXT "小時(&H)", -1, 20, 38, 42, 12
    EDITTEXT IDC_COUNTDOWN_HOURS, 18, 52, 44, 18, ES_NUMBER | ES_CENTER | WS_TABSTOP
    LTEXT "分鐘(&M)", -1, 91, 38, 42, 12
    EDITTEXT IDC_COUNTDOWN_MINUTES, 89, 52, 44, 18, ES_NUMBER | ES_CENTER | WS_TABSTOP
    LTEXT "秒(&S)", -1, 164, 38, 42, 12
    EDITTEXT IDC_COUNTDOWN_SECONDS, 160, 52, 44, 18, ES_NUMBER | ES_CENTER | WS_TABSTOP
    LTEXT "", IDC_COUNTDOWN_ERROR, 12, 77, 216, 16
    DEFPUSHBUTTON "開始", IDOK, 124, 102, 48, 16
    PUSHBUTTON "取消", IDCANCEL, 180, 102, 48, 16
END

1 VERSIONINFO
FILEVERSION APP_VERSION_NUM
PRODUCTVERSION APP_VERSION_NUM
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040404B0"
        BEGIN
            VALUE "CompanyName", ""
            VALUE "FileDescription", "日期時間螢幕保護程式"
            VALUE "FileVersion", APP_VERSION_STR
            VALUE "InternalName", "my_datetime_screensaver"
            VALUE "LegalCopyright", "Copyright (c) 2026 kisaraki"
            VALUE "OriginalFilename", "MyDateTimeScreensaver.scr"
            VALUE "ProductName", "MyDateTimeScreensaver"
            VALUE "ProductVersion", APP_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0404, 1200
    END
END
